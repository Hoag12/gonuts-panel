@@ -0,0 +1,42 @@
+package dev.doughbay.fabric.hosted;
+
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class RelayLinkTest {
+    /** The link origin is process-wide; never leak a test origin into another suite. */
+    @AfterEach void reset() { RelayLink.setForTest(null); }
+
+    @Test void derivesEndpoints() {
+        RelayLink.setForTest("https://panel.example.com");
+        assertTrue(RelayLink.enabled());
+        assertEquals("https://panel.example.com/dashboard/", RelayLink.page().toString());
+        assertEquals("https://panel.example.com/dashboard/api/pair/redeem", RelayLink.redeem().toString());
+        assertEquals("https://panel.example.com/dashboard/api/client/check", RelayLink.check().toString());
+        assertEquals("wss://panel.example.com/dashboard/ws/client", RelayLink.socket().toString());
+        assertEquals("panel.example.com", RelayLink.hostLabel());
+    }
+    @Test void rejectsPathAndInsecureRemote() {
+        assertThrows(IllegalArgumentException.class, () -> RelayLink.setForTest("https://panel.example.com/x"));
+        assertThrows(IllegalArgumentException.class, () -> RelayLink.setForTest("http://example.com"));
+        assertEquals("http://localhost:8080", RelayLink.normalize("http://localhost:8080/"));
+        assertEquals("http://192.168.1.50:8080", RelayLink.normalize("http://192.168.1.50:8080/"));
+        assertThrows(IllegalArgumentException.class, () -> RelayLink.setForTest("http://203.0.113.5:8080"));
+    }
+    @Test void disabledByDefault() {
+        RelayLink.setForTest("");
+        assertFalse(RelayLink.enabled());
+    }
+    @Test void privateLanHttpAcceptedAndPublicHttpRejected() {
+        RelayLink.setForTest("http://10.0.0.5:8080");
+        assertTrue(RelayLink.enabled());
+        assertEquals("http://10.0.0.5:8080/dashboard/", RelayLink.page().toString());
+        assertEquals("ws://10.0.0.5:8080/dashboard/ws/client", RelayLink.socket().toString());
+        assertEquals("10.0.0.5:8080", RelayLink.hostLabel());
+        assertEquals("http://172.16.4.2:9000", RelayLink.normalize("http://172.16.4.2:9000"));
+        assertThrows(IllegalArgumentException.class, () -> RelayLink.setForTest("http://172.15.0.1:8080"));
+        assertThrows(IllegalArgumentException.class, () -> RelayLink.setForTest("http://8.8.8.8"));
+        assertThrows(IllegalArgumentException.class, () -> RelayLink.setForTest("ftp://panel.example.com"));
+    }
+}
