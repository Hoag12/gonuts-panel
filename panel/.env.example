GONUTS_ADDR=:8080
GONUTS_PUBLIC_BASE_URL=https://panel.example.com
GONUTS_DATA_DIR=/data
GONUTS_DISCORD_CLIENT_ID=
GONUTS_DISCORD_CLIENT_SECRET=
GONUTS_ALLOWED_DISCORD_IDS=
# Local sign-in. Generate the hash with: gonuts-panel -hash-password 'your password'
GONUTS_LOCAL_PASSWORD_HASH=
# Plaintext fallback for local sign-in; prefer the hash above.
GONUTS_LOCAL_PASSWORD=
GONUTS_LOCAL_USER=owner
GONUTS_TRUST_PROXY=1
GONUTS_DEV_LOGIN=0
# Local test only: auto-create a loopback session and skip the login page.
# Refused unless GONUTS_ADDR and GONUTS_PUBLIC_BASE_URL are both loopback.
GONUTS_AUTH_DISABLED=0
# Explicit opt-in for unauthenticated access on a non-loopback address.
# DANGEROUS: anyone who can reach the panel gets full bot control.
GONUTS_ALLOW_UNAUTH_LAN=0
GONUTS_COOKIE_SECURE=1
